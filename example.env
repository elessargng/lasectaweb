# Configuración del Backend (Express)
PORT=
JWT_SECRET=
DATABASE_FILE=
UPLOAD_DIR=
LIBRARY_STORAGE_PATH=

# Configuración del Frontend (Vite)
VITE_API_URL=

# Integración con Villacuervos
VILLACUERVOS_CULT_SLUG=
VILLACUERVOS_API_TOKEN=

# Integración con Twitter
TWITTER_BEARER_TOKEN=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_TOKEN=
TWITTER_TOKEN_SECRET=

# Configuración de VigilanteService (Cron de publicaciones automáticas)
# Ejemplos: "*/5 * * * *" para cada 5 minutos, u "off" para deshabilitar
VIGILANTE_CRON=

# Sincronización semanal con Villacuervos del catálogo de personajes de BotC (tabla personajes,
# iconos en UPLOAD_DIR/personajes), de sus traducciones (tablas idiomas y traducciones_personajes)
# y de las reglas del Djinn (tabla reglas_djinn).
# Por defecto los lunes a las 4:30; "off" para deshabilitarla.
PERSONAJES_SYNC_CRON="30 4 * * 1"

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_REAL_NAME=""

# Videollamada de la sala (cámaras y micrófonos): servidor LiveKit (ver docs/videollamada.md).
# Sin estas tres, la sala funciona igual pero sin cámaras ni micrófonos.
# En desarrollo, con «livekit-server --dev»: ws://127.0.0.1:7880, devkey y secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Opcional: la dirección de la API de LiveKit para este servidor si no es la de LIVEKIT_URL con http(s)
# (p. ej. http://localhost:7880 si LiveKit corre en la misma máquina).
LIVEKIT_API_URL=
